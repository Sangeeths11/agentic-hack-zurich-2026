# Copy to .env. Never put real credentials in this template.
# Required for actual calls (not for `familyshield simulate`).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GRADIUM_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# HTTPS origin only, no path. run_local.sh sets this in its process automatically.
PUBLIC_HTTP_URL=

# German by default. Empty voice ID selects Gradbot's language default.
OPERATOR_NAME=Sangeeth
AGENT_LANGUAGE=de
GRADIUM_VOICE_ID=
# Optional Gradium regional endpoint; empty uses the SDK default.
GRADIUM_BASE_URL=

# Optional: YOUR test smartphone, E.164. Only the explicit `call-me` CLI dials it.
TEST_PHONE_NUMBER=

# Limits are PER WORKER. Match the sum across replicas to your provider quotas.
MAX_CONCURRENT_CALLS=2
MAX_CALL_SECONDS=300
SESSION_START_TIMEOUT_SECONDS=15
FIRST_AUDIO_TIMEOUT_SECONDS=20
PROVIDER_IDLE_TIMEOUT_SECONDS=45
MEDIA_IDLE_TIMEOUT_SECONDS=20
SILENCE_TIMEOUT_SECONDS=8
