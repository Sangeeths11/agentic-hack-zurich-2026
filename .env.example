# Family Shield — Twilio foundation. Copy to .env and fill in.
#
# scripts/setup.sh scaffolds this file for you.
# scripts/run_local.sh fills in PUBLIC_HTTP_URL from the tunnel automatically.

# ── Required ─────────────────────────────────────────────────────────────

# Twilio account credentials — console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio voice-enabled number, E.164 (e.g. +41...)
TWILIO_PHONE_NUMBER=

# Where an inbound call gets transferred for the phone-path test, E.164.
# This stands in for "the protected person's phone" until routing/verification
# logic replaces it.
DESTINATION_PHONE_NUMBER=

# ── Public reachability (set automatically by scripts/run_local.sh) ───────

PUBLIC_HTTP_URL=

# ── Optional ─────────────────────────────────────────────────────────────

# Name spoken in the greeting.
OPERATOR_NAME=Family Shield

# ── Local-dev only — NEVER set this on a public host ───────────────────────

# 1 = skip Twilio signature verification when TWILIO_AUTH_TOKEN isn't set,
# so you can hit /twilio/voice with curl before you have real Twilio creds.
ALLOW_INSECURE_LOCAL=
