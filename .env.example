# Copy to .env; keep real credentials and contact details out of Git.
GRADIUM_API_KEY=
# GEMINI_API_KEY takes precedence; existing LLM_API_KEY remains supported.
GEMINI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
AGENT_LANGUAGE=en
# Empty uses the documented English default voice.
GRADIUM_VOICE_ID=
GRADIUM_BASE_URL=https://api.gradium.ai

# Optional email alerts. All three must be valid. Use a Resend-verified sender.
# Enabling these authorizes runtime alerts at 50/75/90 when listening starts.
# doctor --live NEVER sends email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
FALLBACK_EMAIL=

# Optional WhatsApp alerts. The guardian must activate CallMeBot for their number.
# The API key stays on this server; the UI can change the number for the next session.
# A different guardian requires that number's CallMeBot key. No test sends messages.
CALLMEBOT_API_KEY=
GUARDIAN_PHONE=

CALLER_DEFAULT_REGION=CH
# Optional override; normally uses the preserved repository/packaged SQLite database.
# SCAM_DB_PATH=/absolute/path/to/scam_numbers.db
WARNING_THRESHOLD=50
CLASSIFICATION_INTERVAL_SECONDS=1.5
TRANSCRIPT_MAX_CHARS=12000
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_SESSIONS=1
MAX_SESSION_SECONDS=300
SESSION_START_TIMEOUT_SECONDS=15
PROVIDER_IDLE_TIMEOUT_SECONDS=45
MEDIA_IDLE_TIMEOUT_SECONDS=20
# FIRST_AUDIO_TIMEOUT_SECONDS is obsolete: healthy sessions may never produce TTS.
