# Copy to .env. Never put real credentials in this template.
# Only these two keys are required for the voice agent.
GRADIUM_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

OPERATOR_NAME=Sangeeth
AGENT_LANGUAGE=de
# Empty voice ID selects Gradbot's language default.
GRADIUM_VOICE_ID=
# Optional regional endpoint; empty uses the SDK default.
GRADIUM_BASE_URL=

# Local browser sessions. Idle listening does not open a provider session.
MAX_CONCURRENT_SESSIONS=1
MAX_SESSION_SECONDS=300
SESSION_START_TIMEOUT_SECONDS=15
FIRST_AUDIO_TIMEOUT_SECONDS=20
PROVIDER_IDLE_TIMEOUT_SECONDS=45
MEDIA_IDLE_TIMEOUT_SECONDS=20
SILENCE_TIMEOUT_SECONDS=8
